NODE_ENV=development
APP_NAME=fruit-b2b-api
APP_PORT=3000
API_PREFIX=api
API_VERSION=v1
APP_TIMEZONE=Asia/Shanghai
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

MYSQL_DATABASE=fruit_b2b
MYSQL_USER=fruit_b2b
MYSQL_PASSWORD=change_me_local
MYSQL_ROOT_PASSWORD=change_me_root_local
MYSQL_PORT=13306
MYSQL_SLOW_QUERY_SECONDS=1
DATABASE_URL=mysql://fruit_b2b:change_me_local@localhost:13306/fruit_b2b

REDIS_PORT=16379
REDIS_URL=redis://localhost:16379/0
REDIS_KEY_PREFIX=fruit-b2b:local:
CATEGORY_CACHE_TTL_SECONDS=300
HOME_CONFIG_CACHE_TTL_SECONDS=300
DASHBOARD_CACHE_TTL_SECONDS=15
CUSTOMER_SMS_PROVIDER=console
ALLOW_INSECURE_DEV_SMS=false
SMS_HTTP_ENDPOINT=
SMS_HTTP_TOKEN=
SMS_TEMPLATE_ID=
SMS_HTTP_TIMEOUT_MS=5000

JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_with_a_different_32_char_secret
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=30d
JWT_ISSUER=fruit-b2b-api
JWT_AUDIENCE=fruit-b2b-clients
BACKUP_CRON=0 2 * * *
BACKUP_RETENTION_DAYS=14

BOOTSTRAP_TENANT_CODE=DEFAULT
BOOTSTRAP_TENANT_NAME=鲜链云水果批发
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe_123456
BOOTSTRAP_ADMIN_NAME=系统管理员
BOOTSTRAP_WAREHOUSE_CODE=WH_DEFAULT
BOOTSTRAP_WAREHOUSE_NAME=默认仓库

WECHAT_APP_ID=wx0000000000000000
WECHAT_APP_SECRET=replace_me

STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PROVIDER=LOCAL
STORAGE_PUBLIC_URL=
STORAGE_FORCE_PATH_STYLE=true
UPLOAD_DIR=uploads
PDF_FONT_PATH=
STORAGE_CDN_BASE_URL=

VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:3000
