{
  "name": "@fruit-b2b/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migration:create": "typeorm-ts-node-commonjs -d src/infrastructure/database/data-source.ts migration:create",
    "migration:generate": "typeorm-ts-node-commonjs -d src/infrastructure/database/data-source.ts migration:generate",
    "migration:run": "typeorm-ts-node-commonjs -d src/infrastructure/database/data-source.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d src/infrastructure/database/data-source.ts migration:revert",
    "seed:run": "ts-node -r tsconfig-paths/register src/infrastructure/database/seed.ts",
    "seed:compiled": "node dist/infrastructure/database/seed.js",
    "seed:catalog-test": "ts-node -r tsconfig-paths/register src/infrastructure/database/catalog-test.seed.ts",
    "test:catalog:integration": "node test/catalog-foundation.integration.mjs",
    "test:orders:integration": "node test/order-core.integration.mjs",
    "test:fulfillment:integration": "node test/order-core.integration.mjs",
    "test:finance:integration": "node test/order-core.integration.mjs",
    "test:production-readiness": "node test/production-readiness.performance.mjs",
    "test:procurement:integration": "node test/procurement-foundation.integration.mjs",
    "test:customer-center:integration": "node test/customer-center.integration.mjs",
    "test:finance-media:integration": "node test/finance-media.integration.mjs",
    "test:data-consistency": "node test/data-consistency.audit.mjs",
    "test:acceptance": "npm run test:catalog:integration && npm run test:orders:integration && npm run test:procurement:integration && npm run test:data-consistency"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@fruit-b2b/contracts": "0.1.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/typeorm": "^11.0.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "express": "^5.2.1",
    "ioredis": "^5.7.0",
    "multer": "^2.2.0",
    "mysql2": "^3.14.4",
    "nestjs-pino": "^4.4.1",
    "pdfkit": "^0.17.2",
    "pino": "^9.9.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "typeorm": "^0.3.26"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.18.6",
    "@types/pdfkit": "^0.17.6",
    "dotenv": "^17.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  }
}
