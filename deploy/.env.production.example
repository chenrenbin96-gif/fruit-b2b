APP_DOMAIN=admin.example.com
API_IMAGE=registry.example.com/fruit-b2b/api:2026.07.25
ADMIN_IMAGE=registry.example.com/fruit-b2b/admin:2026.07.25
BACKUP_IMAGE=registry.example.com/fruit-b2b/backup:2026.07.25

MYSQL_DATABASE=fruit_b2b
MYSQL_USER=fruit_b2b
MYSQL_PASSWORD=REPLACE_FROM_SECRET_MANAGER
MYSQL_ROOT_PASSWORD=REPLACE_FROM_SECRET_MANAGER
MYSQL_SLOW_QUERY_SECONDS=1
DATABASE_URL=mysql://fruit_b2b:URL_ENCODED_PASSWORD@mysql:3306/fruit_b2b
REDIS_PASSWORD=REPLACE_FROM_SECRET_MANAGER
REDIS_URL=redis://:URL_ENCODED_PASSWORD@redis:6379/0
CATEGORY_CACHE_TTL_SECONDS=300
DASHBOARD_CACHE_TTL_SECONDS=15

CORS_ORIGINS=https://admin.example.com
JWT_ACCESS_SECRET=REPLACE_WITH_64_RANDOM_BYTES
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_64_RANDOM_BYTES
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=30d
JWT_ISSUER=fruit-b2b-production
JWT_AUDIENCE=fruit-b2b-clients

CUSTOMER_SMS_PROVIDER=http
SMS_HTTP_ENDPOINT=https://sms-gateway.example.com/v1/messages
SMS_HTTP_TOKEN=REPLACE_FROM_SECRET_MANAGER
SMS_TEMPLATE_ID=REPLACE_APPROVED_TEMPLATE_ID
SMS_HTTP_TIMEOUT_MS=5000

OBJECT_STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=https://oss-cn-example.aliyuncs.com
STORAGE_REGION=cn-example
STORAGE_BUCKET=fruit-b2b-production
STORAGE_ACCESS_KEY=REPLACE_FROM_SECRET_MANAGER
STORAGE_SECRET_KEY=REPLACE_FROM_SECRET_MANAGER
STORAGE_CDN_BASE_URL=https://img.example.com

BACKUP_CRON=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_HOST_DIR=/srv/fruit-b2b/backups
